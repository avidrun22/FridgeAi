# Copy this file to `.env` (which is gitignored) and fill in real values.
# Vite exposes any var prefixed with VITE_ to the client bundle.
#
# Both values are SAFE to ship in the public bundle — Supabase RLS is what
# actually protects your data. The anon key only allows what your RLS
# policies allow. Don't put server-side secrets (service role key) here.

VITE_SUPABASE_URL=https://qemarhvgeuzhlwybmbie.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
