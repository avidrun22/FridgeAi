{
  "expo": {
    "name": "ok2eat",
    "slug": "ok2eat",
    "version": "1.19",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ok2eat",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EADC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gregorygoldberg.ok2eat",
      "buildNumber": "23",
      "associatedDomains": [
        "applinks:ok2eat.com",
        "applinks:app.ok2eat.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "ok2eat uses your camera to read grocery receipts and scan product barcodes. Photos stay on your device.",
        "NSPhotoLibraryUsageDescription": "ok2eat needs access to your photos so you can pick a saved grocery receipt to scan instead of taking a new one.",
        "NSLocationWhenInUseUsageDescription": "ok2eat does not use your location. This description is required by a third-party library.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0EADC",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "package": "com.gregorygoldberg.ok2eat"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ok2eat uses your camera to read grocery receipts and scan product barcodes. Photos stay on your device."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "./plugins/withIosDevelopmentTeam"
    ],
    "extra": {
      "eas": {
        "projectId": "d9db70a2-7701-4f19-9f21-066a632882fa"
      }
    }
  }
}